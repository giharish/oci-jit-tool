PORT=8090

# Local demo default. Production should use JIT_DB_BACKEND=postgresql.
JIT_DB_BACKEND=sqlite
JIT_DB_PATH=./data/jit_production_app.db

# Production OCI PostgreSQL configuration.
# Use an existing OCI PostgreSQL database and a dedicated schema created with database/postgresql_schema.sql.
# JIT_DB_BACKEND=postgresql
# JIT_POSTGRES_DSN=host=<postgres-fqdn> port=5432 dbname=<existing_database> user=jit_access_app password=<secret> sslmode=verify-full
# JIT_POSTGRES_SCHEMA=customer_jit_access
# Option A: certificate file packaged in the Function image.
# JIT_POSTGRES_SSLROOTCERT_PATH=/function/certs/dbsystem.pub
# Option B: certificate PEM injected from OCI Vault/Function config; app writes it to /tmp at startup.
# JIT_POSTGRES_SSLROOTCERT_PEM="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# JIT_AUTO_INIT_DB=false

# OCI connector mode.
# Local demo can use mock. Production should use oci with resource principal or api-key auth.
JIT_CONNECTOR_MODE=mock
# JIT_CONNECTOR_MODE=oci
# JIT_OCI_AUTH_MODE=resource_principal
# JIT_OCI_AUTH_MODE=api_key
# JIT_OCI_CONFIG_FILE=~/.oci/config
# JIT_OCI_PROFILE=DEFAULT
# Required for organization discovery across parent + child tenancies.
# JIT_ORGANIZATION_OCID=ocid1.organization.oc1..<organization>
# Groups/policies are Terraform-managed; the app only discovers groups with this prefix and adds/removes users.
# JIT_GROUP_PREFIX=JIT-
# Dynamic custom policy creation is disabled for production.
# JIT_ALLOW_CUSTOM_POLICIES=false
# JIT_DEFAULT_DURATION_MINUTES=60
# JIT_MAX_DURATION_MINUTES=240
# JIT_MAX_EXTENSIONS=2
JIT_JIRA_MODE=mock
JIT_MOCK_CHILD_TENANCY_COUNT=25
JIT_PARENT_TENANCY_OCID=ocid1.tenancy.oc1..parent

# Only configured admins can approve, revoke, view all requests, run catalog sync, and run workers.
# Requesters are derived from authenticated identity headers or anonymous request form input.
JIT_AUTHORIZED_USERS={"platform.owner@customer.example":"admin","iam.admin@customer.example":"admin"}

# Local simulator only. In production this identity must come from API Gateway/OIDC headers or IAM auth.
# Leave unset to test anonymous requester mode.
# JIT_LOCAL_AUTH_EMAIL=iam.admin@customer.example
