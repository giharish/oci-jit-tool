{
  "JIT_DB_BACKEND": "postgresql",
  "JIT_POSTGRES_SCHEMA": "customer_jit_access",
  "JIT_AUTO_INIT_DB": "false",
  "JIT_POSTGRES_DSN": "host=<postgres-fqdn> port=5432 dbname=<existing_database> user=jit_access_app password=<vault-or-injected-secret> sslmode=verify-full",
  "JIT_POSTGRES_SSLROOTCERT_PATH": "/function/certs/dbsystem.pub",
  "JIT_CONNECTOR_MODE": "oci",
  "JIT_OCI_AUTH_MODE": "resource_principal",
  "JIT_ORGANIZATION_OCID": "",
  "JIT_GROUP_PREFIX": "JIT-",
  "JIT_ALLOW_CUSTOM_POLICIES": "false",
  "JIT_DEFAULT_DURATION_MINUTES": "60",
  "JIT_MAX_DURATION_MINUTES": "240",
  "JIT_MAX_EXTENSIONS": "2",
  "JIT_JIRA_MODE": "jira",
  "JIT_NOTIFICATION_MODE": "smtp",
  "JIT_SMTP_HOST": "smtp.email.<region>.oci.oraclecloud.com",
  "JIT_SMTP_PORT": "587",
  "JIT_SMTP_USERNAME": "<smtp-user-from-vault-or-function-config>",
  "JIT_SMTP_PASSWORD": "<smtp-password-from-vault-or-function-config>",
  "JIT_SMTP_SENDER": "jit-access@customer.com",
  "JIT_SMTP_STARTTLS": "true",
  "JIT_PORTAL_AUTH_MODE": "trusted_header",
  "JIT_ALLOW_SELF_REGISTRATION": "true",
  "JIT_ALLOW_ANONYMOUS_REQUESTS": "false",
  "JIT_ALLOWED_EMAIL_DOMAINS": "customer.com,oracle.com",
  "JIT_USER_TENANCY_MAP": "{\"user1@customer.com\":[\"ocid1.tenancy.oc1..child1\",\"ocid1.tenancy.oc1..child2\"]}",
  "JIT_REQUIRE_EMAIL_VERIFICATION": "true",
  "JIT_PORTAL_BASE_URL": "https://<gateway-host>/jit/",
  "JIT_SESSION_SECRET": "<generate-a-long-random-secret-if-builtin-login-is-enabled>",
  "JIT_SESSION_TTL_MINUTES": "480",
  "JIT_BUILTIN_USERS": "{}",
  "JIT_PARENT_TENANCY_OCID": "ocid1.tenancy.oc1..<single-tenancy>",
  "JIT_AUTHORIZED_USERS": "{\"platform.owner@customer.example\":\"admin\",\"iam.admin@customer.example\":\"admin\"}"
}
